{
  "name": "iroiroppa",
  "productName": "Iroiroppa",
  "version": "1.2.2",
  "description": "Iroiroppa - a color picker for Clip Studio Paint that connects through Companion Mode (smartphone mode).",
  "main": "src/main/main.js",
  "license": "GPL-3.0-or-later",
  "author": "daisharaima",
  "repository": {
    "type": "git",
    "url": "https://github.com/daisharaima/Iroiroppa.git"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/*.test.js\"",
    "probe": "node scripts/probe.js",
    "icon": "node scripts/make-icon.js",
    "icc": "node scripts/make-icc.js",
    "vendor:helmlab": "node scripts/vendor-helmlab.js",
    "screenshot": "node scripts/screenshot.js",
    "wiki:images": "node scripts/screenshot.js --out wiki/images/palette.png && node scripts/screenshot.js --settings --settings-tab general --out wiki/images/settings.png && node scripts/screenshot.js --settings --settings-tab appearance --out wiki/images/settings-appearance.png && node scripts/screenshot.js --settings --settings-tab modules --out wiki/images/settings-modules.png && node scripts/screenshot.js --settings --settings-tab shortcuts --out wiki/images/settings-shortcuts.png && node scripts/screenshot.js --settings --settings-tab layout --out wiki/images/settings-layout.png",
    "wiki:check": "node scripts/wiki.js check",
    "wiki:publish": "node scripts/wiki.js publish",
    "bench": "node scripts/bench.js",
    "map": "node scripts/map.js",
    "i18n": "node scripts/i18n.js",
    "theme:check": "node scripts/theme-check.js",
    "theme:docs": "node scripts/theme-docs.js",
    "theme:preview": "node scripts/theme-preview.js",
    "pack": "npm run icon && electron-builder --dir",
    "pack:run": "npm run pack && node scripts/launch-packed.js",
    "dist": "npm run icon && electron-builder --win"
  },
  "dependencies": {
    "jscolorengine": "^1.6.1",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "culori": "4.0.2",
    "electron": "44.6.0",
    "electron-builder": "^26.15.3",
    "helmlab": "1.0.0",
    "lcms-wasm": "^1.0.5"
  },
  "build": {
    "appId": "com.iroiroppa.app",
    "productName": "Iroiroppa",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY.md",
      "release-notes/**/*.md"
    ],
    "asarUnpack": [
      "src/main/workers/**",
      "src/main/*.ps1"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.exe"
    }
  }
}
